{
  "manifest_version": 3,
  "name": "流译 · YouTube 字幕、弹幕与评论翻译",
  "short_name": "流译",
  "description": "直播翻译音频，视频字幕整片翻译并缓存；YouTube 弹幕、评论翻译；划词翻译与日英朗读，支持微软和 Gemini 语音。",
  "version": "0.4.0",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dev.microsofttranslator.com/*",
    "https://*.tts.speech.microsoft.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "流译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/ui/options.html",
  "commands": {
    "toggle-session": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "开始 / 停止当前标签页的实时翻译"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "js": [
        "src/main-world/page-bridge.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/common/constants.js",
        "src/common/settings.js",
        "src/common/prompt.js",
        "src/common/live-log.js",
        "src/common/youtube-text.js",
        "src/audio/pcm16k.js",
        "src/content/gemini-live.js",
        "src/content/qwen-live.js",
        "src/content/stabilizer.js",
        "src/content/audio-tap.js",
        "src/content/caption-layer.js",
        "src/content/youtube.js",
        "src/subs/json3.js",
        "src/subs/segmenter.js",
        "src/subs/chunker.js",
        "src/subs/scheduler.js",
        "src/subs/net.js",
        "src/subs/text-model.js",
        "src/common/live-context.js",
        "src/subs/cache.js",
        "src/content/video-subs.js",
        "src/content/main.js",
        "src/content/youtube-comments.js"
      ],
      "css": [
        "src/content/caption-layer.css",
        "src/content/youtube-text.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/common/constants.js",
        "src/common/settings.js",
        "src/common/youtube-text.js",
        "src/content/youtube-chat.js"
      ],
      "css": [
        "src/content/youtube-text.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/audio/pcm16k.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
