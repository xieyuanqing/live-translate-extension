{
  "manifest_version": 3,
  "name": "流译 · YouTube 直播实时翻译与整片字幕",
  "short_name": "流译",
  "description": "直播：抓取播放器音频经 Gemini Live 实时翻译。视频与回放：读取 YouTube 字幕轨，用文字模型整片翻译并缓存。字幕直接叠在播放器里。",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "流译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/ui/options.html",
  "commands": {
    "toggle-session": {
      "suggested_key": { "default": "Alt+T" },
      "description": "开始 / 停止当前标签页的实时翻译"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "world": "MAIN",
      "run_at": "document_start",
      "js": ["src/main-world/page-bridge.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/common/constants.js",
        "src/common/settings.js",
        "src/common/prompt.js",
        "src/audio/pcm16k.js",
        "src/content/gemini-live.js",
        "src/content/stabilizer.js",
        "src/content/audio-tap.js",
        "src/content/caption-layer.js",
        "src/content/youtube.js",
        "src/subs/json3.js",
        "src/subs/segmenter.js",
        "src/subs/chunker.js",
        "src/subs/scheduler.js",
        "src/subs/net.js",
        "src/subs/text-model.js",
        "src/subs/cache.js",
        "src/content/video-subs.js",
        "src/content/main.js"
      ],
      "css": ["src/content/caption-layer.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/audio/pcm16k.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
